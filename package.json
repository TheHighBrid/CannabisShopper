{
  "name": "cannabis-shopper",
  "version": "2.0.0",
  "description": "CanShop: a research-focused craft cannabis flower comparison tool for legal-age adults in Canada.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "check:web": "node --check app/src/main/assets/app.js",
    "check": "npm run typecheck && npm run test && npm run check:web"
  },
  "keywords": ["cannabis", "craft-flower", "comparison", "canada", "research", "android"],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
